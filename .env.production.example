# Example deployment binding; adjust the host and port for your server.
APP_HOST=0.0.0.0
APP_PORT=5010
LOG_FILE=logs/app.log

# Model provider: auto, dashscope, or anthropic.
MODEL_PROVIDER=auto
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/apps/anthropic
ANTHROPIC_MODEL=qwen3.8-flash

# Models.
QWEN_TEXT_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen3-vl-plus
MFC_VISION_MODEL=qwen3.7-flash
MFC_ENABLE_THINKING=false
MFC_THINKING_BUDGET=1024

# Detection timeouts and retries.
TEXT_VERDICT_TIMEOUT_SECONDS=90
VISION_MAX_ROUNDS=3
VISION_VERDICT_TIMEOUT_SECONDS=120
IFD_MODEL_FAILURE_MAX_RETRIES=2
MFC_DETECTION_TIMEOUT_SECONDS=60
# End-to-end budget and model-selected search rounds.
MFC_AGENT_TIMEOUT_SECONDS=120
MFC_MAX_TOOL_ROUNDS=3
MFC_INVALID_OUTPUT_MAX_RETRIES=2
MFC_MAX_TOKENS=1800
MFC_IMAGE_MAX_SIDE=768
MFC_MAX_IMAGES=4

# MFC tools.
# Retained for standalone OCR configuration; MFC currently exposes web search only.
MFC_OCR_ENABLED=false
MFC_OCR_TIMEOUT_SECONDS=30
MFC_OCR_MAX_TOKENS=900
MFC_OCR_IMAGE_MAX_SIDE=1600
MFC_EXTERNAL_EVIDENCE_ENABLED=true
# Maximum actual searches across all rounds (no automatic pre-search).
MFC_SEARCH_QUERY_COUNT=3
MFC_SEARCH_RESULTS_PER_QUERY=3
MFC_SEARCH_TOTAL_RESULTS=6
MFC_SEARCH_SNIPPET_CHARACTERS=250
BOCHA_API_KEY=
BOCHA_SEARCH_URL=https://api.bochaai.com/v1/web-search
SEARCH_TIMEOUT_SECONDS=15

# Local runtime directories.
VISION_OUTPUT_DIR=outputs/vision

# Reserved compatibility settings; the current runtime does not require Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL_SECONDS=2592000
