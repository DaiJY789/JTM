# Runtime
APP_HOST=127.0.0.1
APP_PORT=5000
# Daily log directory and filename prefix.
LOG_FILE=logs/app.log

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL_SECONDS=2592000

# Follow-up explanation
TEXT_VERDICT_TIMEOUT_SECONDS=90

# Vision pipeline
VISION_MAX_ROUNDS=3
VISION_VERDICT_TIMEOUT_SECONDS=120
VISION_OUTPUT_DIR=outputs/vision
IFD_MODEL_FAILURE_MAX_RETRIES=2

# Multimodal misinformation detection
MMD_DETECTION_TIMEOUT_SECONDS=60
MMD_INVALID_OUTPUT_MAX_RETRIES=2
MMD_MAX_TOKENS=1800
MMD_IMAGE_MAX_SIDE=768
MMD_MAX_IMAGES=4
MMD_VISION_MODEL=qwen3.7-flash
MMD_ENABLE_THINKING=false
MMD_THINKING_BUDGET=1024
MMD_OCR_ENABLED=false
MMD_OCR_TIMEOUT_SECONDS=30
MMD_OCR_MAX_TOKENS=900
MMD_OCR_IMAGE_MAX_SIDE=1600
MMD_EXTERNAL_EVIDENCE_ENABLED=true
MMD_SEARCH_QUERY_COUNT=3
MMD_SEARCH_RESULTS_PER_QUERY=3
MMD_SEARCH_TOTAL_RESULTS=6
MMD_SEARCH_SNIPPET_CHARACTERS=250

# Qwen model names
QWEN_TEXT_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen3-vl-plus

# API keys and endpoints
MODEL_PROVIDER=auto
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/apps/anthropic
ANTHROPIC_MODEL=qwen3.8-flash
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BOCHA_API_KEY=
BOCHA_SEARCH_URL=https://api.bochaai.com/v1/web-search
SEARCH_TIMEOUT_SECONDS=15
